enum ENGender {
  MALE
  FEMALE
}

model Person {
  id             String   @id @default(cuid())
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  gender         ENGender
  dob            DateTime @db.Date
  nationality    String
  profilePicture String?  @map("profile_picture")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User?
  memberships Membership[]
  athleteRelations   PersonRelation[] @relation("AthleteRelations")
  relatedPersonLinks PersonRelation[] @relation("RelatedPersonLinks")

  @@map("persons")
}

enum ENIdentifierType {
  EMAIL
  PHONE
  GOOGLE
  APPLE
}

model User {
  id              String  @id @default(cuid())
  passwordHash    String? @map("password_hash")
  twoFactorSecret String? @map("two_factor_secret") // AES-256-GCM ciphertext, never the raw secret

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")

  // boolean
  isEmailVerified    Boolean @default(false) @map("is_email_verified")
  isDeleted          Boolean @default(false) @map("is_deleted")
  isTwoFactorEnabled Boolean @default(false) @map("is_two_factor_enabled")

  // timestamps
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  lastLogin DateTime? @map("last_login") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)

  // relations
  personId String @unique @map("person_id")
  person   Person @relation(fields: [personId], references: [id])
  tokens UserToken[]
  sessions Session[]
  recoveryCodes RecoveryCode[]
  identifiers UserIdentifier[]

  @@map("users")
}

model UserIdentifier {
  id     String           @id @default(cuid())
  type   ENIdentifierType
  value  String

  // boolean
  isPrimary Boolean @default(false) @map("is_primary")

  // timestamps
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // relations
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokens UserToken[]

  @@index([userId])
  @@unique([type, value])
  @@map("user_identifiers")
}

enum ENUserTokenType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  CHANGE_PASSWORD
  LOGIN_OTP // Optional addition if you use OTP login
}

enum ENUserTokenStatus {
  PENDING
  DISRUPTED
}

model UserToken {
  id     String            @id @default(cuid())
  type   ENUserTokenType
  hash   String            @unique
  status ENUserTokenStatus @default(PENDING)
  attempts Int @default(0)

  // relations
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  identifierId String?         @map("identifier_id")
  identifier   UserIdentifier? @relation(fields: [identifierId], references: [id], onDelete: Cascade)

  // timestamps
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  @@index([userId, type, status])
  @@index([identifierId])
  @@map("user_tokens")
}

enum ENInvitationStatus {
  PENDING
  DISRUPTED
}

model Invitation {
  id             String             @id @default(cuid())
  email          String?            @map("email")
  phone          String?            @map("phone")
  tokenHash      String             @unique @map("token_hash")
  failedAttempts Int                @default(0) @map("failed_attempts")
  type           ENMembershipType
  status         ENInvitationStatus @default(PENDING)
  teamId         String?            @map("team_id")

  // relations
  inviterId String     @map("inviter_id")
  inviter   Membership @relation("MembershipSentInvitations", fields: [inviterId], references: [id])

  // timestamps
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  @@index([email, phone])
  @@index([email, tokenHash, status])
  @@index([expiresAt])
  @@map("invitations")
}

model Session {
  id        String  @id @default(cuid())
  userAgent String? @map("user_agent")
  ip        String? @db.VarChar(45)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id   String @id @default(cuid())
  hash String @unique

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  sessionId String  @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model RecoveryCode {
  id       String    @id @default(cuid())
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}
