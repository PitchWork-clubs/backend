enum ENPermissionAction {
  CREATE
  READ
  WRITE
  DELETE
  APPROVE
  EXPORT
  ASSIGN
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String

  module ENFeature
  action ENPermissionAction

  // timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // relations
  rolePermissions       RolePermission[]
  membershipPermissions MembershipPermission[]

  @@map("permissions")
}

model Role {
  id String @id @default(cuid())

  code        String @db.VarChar(10) //
  name        String  @db.VarChar(10)
  description String  @db.VarChar(100)

  isSystem Boolean @default(true) @map("is_system")
  isActive Boolean @default(true) @map("is_active")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // relations
  clubId      String?          @map("club_id")
  club        Club?            @relation(fields: [clubId], references: [id])
  memberships MembershipRole[]
  permissions RolePermission[]

  @@unique([clubId, code])
  @@index([clubId])
  @@map("roles")
}

// permissions that a role has
model RolePermission {
  id String @id @default(cuid())

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

enum ENScopeType {
  CLUB
  TEAM
  OWN
  RELATED
  ANY
}

// roles assigned to membership
model MembershipRole {
  id String @id @default(cuid())

  scope   ENScopeType @default(OWN)
  scopeId String?     @map("scope_id") // Team ID if scopeType is TEAM, otherwise null

  // timestamps
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  // relations
  membershipId String      @map("membership_id")
  membership   Membership  @relation(fields: [membershipId], references: [id])
  roleId       String      @map("role_id")
  role         Role        @relation(fields: [roleId], references: [id])
  assignedById String?     @map("assigned_by")
  assignedBy   Membership? @relation("AssignedRoles", fields: [assignedById], references: [id])

  @@unique([membershipId, roleId, scope, scopeId])
  @@index([membershipId])
  @@map("membership_roles")
}

enum ENMembershipPermissionAction {
  GRANT
  REVOKE
}

model MembershipPermission {
  id     String                       @id @default(cuid())
  action ENMembershipPermissionAction
  scope  ENScopeType                  @default(CLUB)
  scopeId String                      @default("") @map("scope_id")

  // relations
  membershipId String     @map("membership_id")
  membership   Membership @relation(fields: [membershipId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([membershipId, permissionId, scope, scopeId])
  @@index([membershipId, scope, scopeId])
  @@map("membership_permissions")
}
